# 관리자(/admin) Basic 인증 계정 — 실제 값은 .env 에 작성 (커밋 금지)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# 네이버 서치어드바이저 → https://www.saerim.kr → 소유확인 → HTML 태그의 content 값
# Railway 환경변수에도 같은 값 설정. 빈 값이면 인증 태그를 출력하지 않습니다.
NAVER_SITE_VERIFICATION=

# CMS SQLite 데이터 폴더 (기본: ./data, Railway에서는 볼륨 경로 지정)
# DATA_DIR=/data

# 문의 접수 메일 알림 — 미설정 시 메일 없이 접수만 됩니다
#
# [구글 워크스페이스 사용 시]
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USER=계정@saerim.kr (워크스페이스 주소)
#   SMTP_PASS=구글 앱 비밀번호 (myaccount.google.com/apppasswords, 2단계 인증 필요)
#
# [네이버 메일 사용 시]
#   SMTP_HOST=smtp.naver.com (기본값이라 생략 가능)
#   네이버 메일 → 환경설정 → POP3/SMTP 사용 설정 필요
SMTP_HOST=smtp.gmail.com
SMTP_USER=info@saerim.kr
SMTP_PASS=
INQUIRY_NOTIFY_TO=info@saerim.kr
